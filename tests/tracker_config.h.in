#pragma once

// Этот файл - шаблон для CMake (см. configure_file() в CMakeLists.txt).
// CMake сам подставит вместо PROJECT_SOURCE_DIR реальный абсолютный путь
// и запишет результат как обычный сгенерированный заголовок
// (cmake-build-*/generated/tracker_config.h), который потом просто
// инклюдится в instance_tracker.cpp.
//
// если путь к проекту содержит не-ASCII символы (кириллица в имени пользователя Windows и т.п.), передача такой
// строки аргументом командной строки компилятора может быть искажена на
// Windows кодировкой процесса (несовпадение UTF-8 / текущей ANSI-кодовой
// страницы) — из-за этого путь до Tracker.txt получался "битым", и
// std::ofstream просто не мог открыть файл (тихо, без явной ошибки).
// configure_file() пишет файл сам, напрямую, в кодировке исходников
// проекта — без прохождения через кодировку аргументов командной строки,
// поэтому кириллица в пути тут не страшна.
#define TRACKER_OUTPUT_DIR "@PROJECT_SOURCE_DIR@/tests"
